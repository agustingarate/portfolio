# Local environment variables for the contact form.
# Do not commit the resulting .env file.

# Email destination for the contact form.
CONTACT_EMAIL=

# Resend API key.
RESEND_API_KEY=

# Cloudflare Turnstile secret. The public Sitekey lives in src/content/portfolio.ts.
TURNSTILE_SECRET_KEY=

# Public read-only connection to the Sanity dataset. These values are safe to
# expose to the browser; never place a Sanity write token in this file.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
