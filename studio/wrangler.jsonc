{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "admin",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "admin.agustingarate.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
